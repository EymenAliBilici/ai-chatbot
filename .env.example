GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="your_gemini_model for example : gemini-3.5-flash"
GOOGLE_AI_EMBEDDINGS_MODEL="your_google_gemini_embeddings_model for example : gemini-embedding-2"
FILE_PATH="your_pdf_path for example : my_document.pdf"
HOST="localhost or your_mysql_server"
USER="user (root)"
PORT="3306 or your_port"
PASSWORD="your_mysql_password!"
DATABASE="your_mysql_database"